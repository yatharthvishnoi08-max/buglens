{
  "name": "buglens",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Turn visual symptoms into repository-ready issues with a reusable Gemma 4 agent skill.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "start": "next start --hostname 0.0.0.0",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "evals": "node --import tsx evals/run-evals.ts",
    "kill-test": "node --env-file=.env.local --import tsx scripts/kill-test.ts",
    "smoke:gemma": "node --env-file=.env.local --import tsx scripts/smoke-test.ts",
    "fixtures:images": "node --import tsx scripts/render-fixtures.ts",
    "skill:sample": "node --import tsx skills/buglens/scripts/compile-issue.ts --sample",
    "skill:review": "node --import tsx skills/buglens/scripts/review-repository.ts",
    "skill:package": "node --import tsx scripts/package-skill.ts",
    "schemas": "node --import tsx scripts/export-schemas.ts",
    "check:secrets": "node --import tsx scripts/check-secrets.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.17.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tar-stream": "^3.1.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "~3.2.4"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@tailwindcss/postcss": "^4.3.3",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tar-stream": "^3.2.2",
    "zod": "^4.6.7"
  }
}

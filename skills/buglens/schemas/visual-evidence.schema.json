{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "sufficient",
        "insufficient"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "evidence": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,59}$"
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "source": {
            "type": "string",
            "enum": [
              "visual",
              "reporter",
              "unknown"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "required": [
          "id",
          "claim",
          "source",
          "evidence",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "unknowns": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "forbiddenInferences": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  },
  "required": [
    "status",
    "summary",
    "evidence",
    "unknowns",
    "forbiddenInferences"
  ],
  "additionalProperties": false
}
